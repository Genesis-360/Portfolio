# ── Keystatic CMS ──────────────────────────────────────────────────────
# Required for editing content from the live site at /admin (GitHub mode).
# Without these, the admin runs in local mode (dev only).

# 1. Create a GitHub OAuth App → https://github.com/settings/developers
#    Homepage URL:            https://your-domain.com
#    Authorization callback:  https://your-domain.com/admin/api/github/login
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# 2. Any random string (openssl rand -base64 32)
KEYSTATIC_SECRET=

# 3. "owner/repo" of this site
KEYSTATIC_GITHUB_REPO=Genesis-360/Portfolio
