# ── Keystatic CMS ──────────────────────────────────────────────────────
# The Admin UI is mounted at /keystatic (see src/app/keystatic/).
# Without these vars the admin runs in LOCAL mode (writes to your disk, dev only).
#
# Keystatic needs a GitHub APP — not an OAuth App.
#   GitHub App client IDs look like  Iv23li...  or  Iv1....
#   OAuth  App client IDs look like  Ov23li...   <- WRONG, will not work
#
# Easiest way to get all four values: leave this file empty except for
# NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO, run `npm run dev`, open
# http://127.0.0.1:3000/keystatic and click "Create GitHub App". Keystatic
# provisions the app and writes the other three vars into .env for you.

# Which repo the CMS commits to. Must be NEXT_PUBLIC_ so the browser-side
# Admin UI resolves the same storage mode as the server.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=Genesis-360/Portfolio

# From the GitHub App (auto-filled by the setup wizard)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# The GitHub App's URL slug, e.g. https://github.com/apps/<slug>
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Signs the admin session cookie. Generate with: openssl rand -base64 32
KEYSTATIC_SECRET=

# ── Contact form email delivery (Resend) ─────────────────────────────
# Get an API key at https://resend.com/api-keys
# The `from` address must use a domain you've verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@oreenza.com
CONTACT_FROM_EMAIL=Oreenza <noreply@oreenza.com>

# ── GitHub App callback URLs ───────────────────────────────────────────
# Add BOTH under App settings -> Callback URL:
#   http://127.0.0.1:3000/api/keystatic/github/oauth/callback
#   https://your-domain.com/api/keystatic/github/oauth/callback
